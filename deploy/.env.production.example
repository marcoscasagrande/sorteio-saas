APP_NAME=SorteioSaaS
APP_ENV=production
APP_KEY=                          # gerado com: php artisan key:generate
APP_DEBUG=false
APP_URL=https://seudominio.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sorteio_saas
DB_USERNAME=sorteio_saas
DB_PASSWORD=                      # crie o banco e o usuário pelo aaPanel > Databases

SESSION_DRIVER=database
QUEUE_CONNECTION=database         # dá pra rodar sem Redis; se quiser mais performance, troque pra redis

MERCADOPAGO_ACCESS_TOKEN=         # opcional — pode deixar em branco e cadastrar depois em Admin > Configurações
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

MAIL_MAILER=smtp
# Usado pelo 2FA do admin e pelo "esqueci minha senha" — configure antes
# do primeiro login de administrador, senão o código/link só vai pro log.
# Se o servidor é EC2 da AWS, a porta 25 vem bloqueada por padrão — use
# porta 587 com Amazon SES (ver seção "E-mail na AWS" no README).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contato@seudominio.com
MAIL_FROM_NAME="${APP_NAME}"
